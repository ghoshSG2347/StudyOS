# ==============================================================================
# StudyOS Frontend Environment Variables (Public - Bundled by Vite)
# Put these in your frontend .env.local file.
# NEVER put secrets in VITE_* variables.
# ==============================================================================
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_SITE_URL=http://localhost:5173

# ==============================================================================
# Convex CLI Environment Variable
# Created automatically by `npx convex dev` in your local .env.local
# Do NOT commit your local deployment identifier to source control.
# ==============================================================================
# CONVEX_DEPLOYMENT=dev:your-deployment-identifier

# ==============================================================================
# Convex Backend Environment Variables (Private - Server-only)
# Configure these in the Convex Dashboard (Settings -> Environment Variables)
# or via the Convex CLI using: npx convex env set KEY value
# NEVER expose these with a VITE_ prefix.
# ==============================================================================

# Required for Better Auth session and token security:
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=your-32-byte-random-secret

# Required for Better Auth CORS & trusted origin validation (must match browser origin):
# SITE_URL=http://localhost:5173

# Required for Better Auth base URL (must match your Convex .site URL):
# CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional Google OAuth 2.0 Credentials:
# Authorized redirect URI: https://your-deployment.convex.site/api/auth/callback/google
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional Password Reset Mail Relay:
# If configured, Better Auth POSTs JSON { to, name, resetUrl } with Authorization: Bearer <token>
# PASSWORD_RESET_WEBHOOK_URL=https://your-mail-service.example.com/api/send-reset
# PASSWORD_RESET_WEBHOOK_TOKEN=your-webhook-bearer-token

# Optional AI Provider Configuration (AI is optional; StudyOS works 100% without AI):
# AI_PROVIDER=gemini
